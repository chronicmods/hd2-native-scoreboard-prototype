<Page
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:noesis="clr-namespace:NoesisGUIExtensions"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  xmlns:testament="clr-namespace:testament"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080"
  x:Class="ui.OverlayHud"
  d:DataContext="overlay_hud"
  FontFamily="/testament;component/font/#FS Sinclair"
  noesis:Loc.Source="/testament;component/shared/localization/generated/strings_us.xaml"
  Focusable="False"
  IsHitTestVisible="False">

  <!--
    The two hidden controls are independent held-state latches. The visible
    panel uses two DataTriggers (logical OR), so releasing F8 does not hide the
    panel while View is still held, and vice versa.
  -->
  <b:Interaction.Triggers>
    <b:KeyTrigger Key="F8" FiredOn="KeyDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="True"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" FiredOn="KeyUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="False"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Shift" FiredOn="KeyDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="True"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Shift" FiredOn="KeyUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="False"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Ctrl" FiredOn="KeyDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="True"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Ctrl" FiredOn="KeyUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="False"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Alt" FiredOn="KeyDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="True"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Alt" FiredOn="KeyUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="False"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Ctrl+Shift" FiredOn="KeyDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="True"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Ctrl+Shift" FiredOn="KeyUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="False"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Alt+Shift" FiredOn="KeyDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="True"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Alt+Shift" FiredOn="KeyUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="False"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Alt+Ctrl" FiredOn="KeyDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="True"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Alt+Ctrl" FiredOn="KeyUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="False"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Alt+Ctrl+Shift" FiredOn="KeyDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="True"/>
    </b:KeyTrigger>
    <b:KeyTrigger Key="F8" Modifiers="Alt+Ctrl+Shift" FiredOn="KeyUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="KeyboardHeldState" PropertyName="IsEnabled" Value="False"/>
    </b:KeyTrigger>
    <noesis:GamepadTrigger Button="View" FiredOn="ButtonDown" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="ControllerHeldState" PropertyName="IsEnabled" Value="True"/>
    </noesis:GamepadTrigger>
    <noesis:GamepadTrigger Button="View" FiredOn="ButtonUp" ActiveOnFocus="False">
      <b:ChangePropertyAction TargetName="ControllerHeldState" PropertyName="IsEnabled" Value="False"/>
    </noesis:GamepadTrigger>
  </b:Interaction.Triggers>

  <Page.Resources>
    <Style x:Key="ColumnHeading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFB9C3C9"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DiverName" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFF2F5F6"/>
      <Setter Property="FontSize" Value="27"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="20,0,12,0"/>
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFF2F5F6"/>
      <Setter Property="FontFamily" Value="/testament;component/font/#Steelworks for HELLDIVERS 2"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
    </Style>
  </Page.Resources>

  <Grid Background="Transparent" IsHitTestVisible="False" Focusable="False">
    <Border x:Name="KeyboardHeldState" Visibility="Collapsed" IsEnabled="False"/>
    <Border x:Name="ControllerHeldState" Visibility="Collapsed" IsEnabled="False"/>

    <Border
      x:Name="HoldScoreboard"
      Width="1180"
      Height="610"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="#EE10161A"
      BorderBrush="#FFF0E44C"
      BorderThickness="2"
      Padding="0"
      IsHitTestVisible="False"
      Focusable="False">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, ElementName=KeyboardHeldState}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, ElementName=ControllerHeldState}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="106"/>
          <RowDefinition Height="54"/>
          <RowDefinition Height="86"/>
          <RowDefinition Height="86"/>
          <RowDefinition Height="86"/>
          <RowDefinition Height="86"/>
          <RowDefinition Height="104"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF1A2329">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#FFF0E44C"/>
          <StackPanel Grid.Column="1" Margin="28,13,0,0">
            <TextBlock Text="MISSION SCOREBOARD" Foreground="#FFF0E44C" FontSize="41" FontWeight="Bold"/>
            <TextBlock Text="ACTIVE SQUAD // HELLDIVERS DEPLOYED" Foreground="#FF9FAAB0" FontSize="18" Margin="2,-3,0,0"/>
          </StackPanel>
          <Border Grid.Column="2" Margin="0,22,28,22" Padding="16,7" BorderBrush="#FF59656C" BorderThickness="1" Background="#8010171B">
            <TextBlock Text="HOLD DISPLAY" Foreground="#FFC8D0D4" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Background="#FF273138">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="HELLDIVER" Style="{StaticResource ColumnHeading}" HorizontalAlignment="Left" Margin="42,0,0,0"/>
          <TextBlock Grid.Column="1" Text="ENEMIES" Style="{StaticResource ColumnHeading}"/>
          <TextBlock Grid.Column="2" Text="DEATHS" Style="{StaticResource ColumnHeading}"/>
          <TextBlock Grid.Column="3" Text="FRIENDLY" Style="{StaticResource ColumnHeading}"/>
          <TextBlock Grid.Column="4" Text="SCORE" Style="{StaticResource ColumnHeading}"/>
        </Grid>

        <Grid Grid.Row="2" Background="#E6161D22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#FFF0E44C"/>
          <TextBlock Grid.Column="1" Text="HELLDIVER 1" Style="{StaticResource DiverName}"/>
          <TextBlock Grid.Column="2" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="3" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="4" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="5" Text="-" Style="{StaticResource Metric}" Foreground="#FFF0E44C"/>
        </Grid>

        <Grid Grid.Row="3" Background="#E61C252B">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#FF4CB8E8"/>
          <TextBlock Grid.Column="1" Text="HELLDIVER 2" Style="{StaticResource DiverName}"/>
          <TextBlock Grid.Column="2" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="3" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="4" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="5" Text="-" Style="{StaticResource Metric}" Foreground="#FF4CB8E8"/>
        </Grid>

        <Grid Grid.Row="4" Background="#E6161D22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#FFD55ADE"/>
          <TextBlock Grid.Column="1" Text="HELLDIVER 3" Style="{StaticResource DiverName}"/>
          <TextBlock Grid.Column="2" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="3" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="4" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="5" Text="-" Style="{StaticResource Metric}" Foreground="#FFD55ADE"/>
        </Grid>

        <Grid Grid.Row="5" Background="#E61C252B">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="187"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#FF5BD17C"/>
          <TextBlock Grid.Column="1" Text="HELLDIVER 4" Style="{StaticResource DiverName}"/>
          <TextBlock Grid.Column="2" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="3" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="4" Text="-" Style="{StaticResource Metric}"/>
          <TextBlock Grid.Column="5" Text="-" Style="{StaticResource Metric}" Foreground="#FF5BD17C"/>
        </Grid>

        <Grid Grid.Row="6" Background="#FF11181C">
          <Grid.RowDefinitions>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Background="#FF465159"/>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="HOLD F8 / CONTROLLER VIEW     RELEASE TO CLOSE" Foreground="#FFF0E44C" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="DESIGNED TO LEAVE MOVEMENT AND COMBAT INPUT ACTIVE" Foreground="#FF98A5AC" FontSize="16" Margin="0,3,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="ASSET-ONLY UI SHELL - LIVE SQUAD STAT DATA IS NOT EXPOSED TO THIS VIEW" Foreground="#FFCF8B78" FontSize="14" Margin="0,3,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
